# Copy to .env.local for local development, or add these in Vercel > Settings > Environment Variables.
# Find both in Supabase > Project Settings > API (use the "anon" / "publishable" key, never the secret key).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
